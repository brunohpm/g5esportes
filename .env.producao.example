# Copie para `.env` em /opt/g5esportes no servidor e preencha.
# Nunca versione o .env real.

# Endereço público, com https://. Precisa bater com o server_name do vhost
# em /etc/nginx/sites-available/g5esportes.
#   homologação: https://g5.prattsolutions.com.br
#   produção:    https://g5esportes.com
#
# ATENÇÃO: este valor também é embutido na imagem no momento do build
# (build-arg NEXT_PUBLIC_SERVER_URL). Trocar aqui NÃO basta — é preciso
# reconstruir e reenviar a imagem com `npm run deploy:imagem`, senão o
# canonical, o sitemap e as imagens de compartilhamento continuam no endereço
# antigo. O robots.txt também depende disto: só libera indexação quando o
# endereço é exatamente https://g5esportes.com.
NEXT_PUBLIC_SERVER_URL=https://g5.prattsolutions.com.br

# Senha do Postgres. Gere com:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Chave que assina as sessões do painel. Trocar depois invalida os logins.
#   openssl rand -hex 32
PAYLOAD_SECRET=
